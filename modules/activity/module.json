{
  "id": "activity",
  "version": "1.0.0",
  "requiresTemplate": "0.19.0",
  "title": {
    "de": "Interaktive Elemente",
    "en": "Interactive elements"
  },
  "summary": "what a course's customer DOES — exercises and checks, judged on the server",
  "docs": "docs/learning.md",
  "skill": "learning-activities",
  "messages": {
    "namespaces": [
      "activity"
    ],
    "dir": "messages"
  },
  "errorCodes": {
    "source": "rules.ts",
    "export": "ACTIVITY_ERROR_CODES"
  },
  "components": {
    "ActivityPanel": "components/activity-panel.tsx",
    "useActivity": "components/activity-panel.tsx"
  },
  "schema": "schema.ts",
  "tables": [
    "activity_results"
  ],
  "tablePrefix": "activity_",
  "content": "collected",
  "migrations": "drizzle",
  "migrationsTable": "__drizzle_migrations_activity",
  "erase": true,
  "privacy": {
    "sections": [
      "activityResults"
    ],
    "accountNotes": {
      "export": "activity.accountExportNote",
      "deletion": "activity.accountDeletionNote"
    },
    "ts": "privacy/sections.ts",
    "mjs": "privacy/sections.mjs"
  },
  "entry": "module.ts",
  "presence": "presence/check.ts"
}
